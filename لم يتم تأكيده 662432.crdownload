  <!-- TikTok Pixel Code End -->

  <style>
    :root{
      --navy:#081a3c;
      --navy-2:#0d2e63;
      --blue:#2468ff;
      --sky:#3fcfff;
      --mint:#39e4bd;
      --gold:#ffc93d;
      --coral:#ff6b61;
      --violet:#845ef7;
      --ink:#10213f;
      --muted:#64748b;
      --paper:#f6f9ff;
      --white:#fff;
      --line:#e7edf8;
      --shadow:0 24px 70px rgba(13,46,99,.16);
      --radius:28px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;min-width:320px;background:linear-gradient(180deg,#fff 0,#f9fbff 35%,#f2f7ff 100%);color:var(--ink);font-family:"Cairo","Tajawal",Arial,sans-serif;overflow-x:hidden}
    a{color:inherit;text-decoration:none}
    button,a{-webkit-tap-highlight-color:transparent}
    svg{display:block}
    .wrap{width:min(1180px,calc(100% - 34px));margin:auto}

    .topbar{background:linear-gradient(90deg,var(--navy),#113a78);color:#dbe7ff;font-size:12px}
    .topbar .wrap{min-height:36px;display:flex;justify-content:space-between;align-items:center;gap:16px}
    .topbar span,.topbar a{display:flex;align-items:center;gap:7px}

    .site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.92);backdrop-filter:blur(18px);border-bottom:1px solid rgba(19,50,93,.08)}
    .nav{min-height:82px;display:flex;align-items:center;justify-content:space-between;gap:22px}
    .brand{display:flex;align-items:center;gap:12px;white-space:nowrap}.brand-logo-img{width:190px;max-width:42vw;height:auto;display:block;filter:drop-shadow(0 10px 20px rgba(13,46,99,.12))}
    
    .nav-links{display:flex;align-items:center;gap:25px;font-size:13px;font-weight:800;color:#425675}
    .nav-links a{position:relative;padding:29px 0}
    .nav-links a:after{content:"";position:absolute;right:0;left:100%;bottom:20px;height:3px;border-radius:4px;background:linear-gradient(90deg,var(--blue),var(--mint));transition:.22s}
    .nav-links a:hover{color:var(--blue)}
    .nav-links a:hover:after{left:0}
    .nav-actions{display:flex;align-items:center;gap:9px}
    .nav-btn{height:42px;padding:0 16px;border-radius:13px;display:inline-flex;align-items:center;gap:8px;color:#fff;font-size:12px;font-weight:900;box-shadow:0 10px 25px rgba(0,0,0,.12)}
    .nav-wa{background:linear-gradient(135deg,#11c977,#16a866)}
    .nav-call{background:linear-gradient(135deg,var(--coral),#f23f54)}
    .menu-btn{display:none;width:44px;height:44px;border:1px solid var(--line);background:#fff;border-radius:13px;color:var(--navy)}

    .hero{position:relative;padding:64px 0 35px;overflow:hidden}
    .hero:before,.hero:after{content:"";position:absolute;border-radius:50%;filter:blur(2px);pointer-events:none}
    .hero:before{width:440px;height:440px;right:-180px;top:-170px;background:radial-gradient(circle,rgba(63,207,255,.27),rgba(63,207,255,0) 68%)}
    .hero:after{width:380px;height:380px;left:-150px;bottom:-130px;background:radial-gradient(circle,rgba(132,94,247,.16),rgba(132,94,247,0) 68%)}
    .hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:52px;align-items:center;position:relative;z-index:1}
    .kicker{display:inline-flex;align-items:center;gap:8px;margin-bottom:15px;padding:7px 13px;border-radius:999px;background:#edf5ff;color:#1e58ce;font-size:11px;font-weight:900;border:1px solid #dceaff}
    .kicker i{width:8px;height:8px;border-radius:50%;background:var(--mint);box-shadow:0 0 0 6px rgba(57,228,189,.12)}
    h1,h2,h3,p{margin-top:0}
    h1{font-family:"Tajawal","Cairo",sans-serif;font-size:clamp(42px,5.7vw,72px);line-height:1.03;letter-spacing:-1.9px;margin-bottom:19px;color:var(--navy);max-width:650px}
    h1 em{font-style:normal;background:linear-gradient(90deg,var(--blue),var(--violet));-webkit-background-clip:text;background-clip:text;color:transparent}
    .hero-copy{max-width:620px;color:#60708a;font-size:16px;line-height:1.95;margin-bottom:25px}
    .hero-actions{display:flex;flex-wrap:wrap;gap:11px;margin-bottom:28px}
    .btn{min-height:52px;padding:12px 22px;border:0;border-radius:14px;display:inline-flex;align-items:center;justify-content:center;gap:9px;font:inherit;font-size:13px;font-weight:900;cursor:pointer;transition:.22s}
    .btn:hover{transform:translateY(-3px)}
    .btn-main{color:#fff;background:linear-gradient(135deg,var(--blue),#4a7dff);box-shadow:0 15px 30px rgba(36,104,255,.25)}
    .btn-light{background:#fff;color:var(--navy);border:1px solid var(--line);box-shadow:0 10px 25px rgba(13,46,99,.08)}
    .hero-trust{display:flex;align-items:center;flex-wrap:wrap;gap:14px;color:#52647e;font-size:12px;font-weight:800}
    .hero-trust span{display:flex;align-items:center;gap:6px}
    .hero-trust b{color:var(--gold);letter-spacing:1px;font-size:15px}

    .hero-slider{position:relative;border-radius:34px 10px 34px 34px;overflow:hidden;min-height:455px;background:var(--navy);box-shadow:var(--shadow);isolation:isolate}
    .hero-slider:before{content:"";position:absolute;inset:0;background:linear-gradient(155deg,rgba(6,23,55,.08),rgba(6,23,55,.72));z-index:2;pointer-events:none}
    .slide{position:absolute;inset:0;opacity:0;transform:scale(1.04);transition:opacity .65s ease,transform 1.1s ease;display:flex;align-items:flex-end;padding:32px;color:#fff}
    .slide.active{opacity:1;transform:scale(1)}
    .slide-bg{position:absolute;inset:0;overflow:hidden}
    .slide-bg img{width:100%;height:100%;object-fit:cover;display:block}.slide-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,18,44,.06),rgba(4,18,44,.42))}.photo-credit{display:none}
    .slide-content{position:relative;z-index:3;max-width:430px}
    .slide-tag{display:inline-flex;padding:6px 11px;border-radius:999px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);backdrop-filter:blur(10px);font-size:10px;font-weight:900;margin-bottom:10px}
    .slide h2{margin:0 0 8px;font-size:31px;line-height:1.25}
    .slide p{margin:0;color:#e5edff;font-size:12px}
    .slide-call{margin-top:15px;display:inline-flex;align-items:center;gap:7px;background:#fff;color:var(--navy);padding:9px 13px;border-radius:12px;font-size:11px;font-weight:900}
    .slider-dots{position:absolute;z-index:5;left:22px;top:22px;display:flex;gap:7px}
    .slider-dot{width:9px;height:9px;border:0;border-radius:50%;background:rgba(255,255,255,.45);cursor:pointer;padding:0}
    .slider-dot.active{width:26px;border-radius:999px;background:#fff}
    .slider-controls{position:absolute;z-index:5;right:22px;top:22px;display:flex;gap:7px}
    .slider-arrow{width:38px;height:38px;border:1px solid rgba(255,255,255,.25);background:rgba(3,19,46,.28);backdrop-filter:blur(8px);border-radius:11px;color:#fff;display:grid;place-items:center;cursor:pointer}

    .portals{padding:20px 0 78px}
    .portal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}
    .portal{position:relative;min-height:245px;overflow:hidden;border-radius:26px;background:#fff;box-shadow:0 14px 38px rgba(13,46,99,.1);border:1px solid #edf1fa;isolation:isolate;transition:.25s}
    .portal:hover{transform:translateY(-7px);box-shadow:0 20px 45px rgba(13,46,99,.16)}
    .portal-art{position:absolute;inset:0}
    .portal-art img{width:100%;height:100%;object-fit:cover;display:block}.portal-art::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,26,60,.03),rgba(8,26,60,.12))}
    .portal:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 27%,rgba(6,23,55,.78) 100%);z-index:1}
    .portal-copy{position:absolute;z-index:2;right:20px;left:20px;bottom:18px;color:#fff}
    .portal-copy small{font-size:10px;font-weight:800;opacity:.8}
    .portal-copy h3{font-size:22px;margin:2px 0 0}
    .portal-copy span{position:absolute;left:0;bottom:2px;width:37px;height:37px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.28);backdrop-filter:blur(7px)}

    .section{padding:78px 0}
    .section-soft{background:linear-gradient(180deg,#f4f8ff,#fff)}
    .section-head{max-width:700px;margin:0 auto 38px;text-align:center}
    .section-head .mini{display:inline-flex;align-items:center;gap:8px;color:var(--blue);font-size:11px;font-weight:900;margin-bottom:8px}
    .section-head .mini:before,.section-head .mini:after{content:"";width:21px;height:2px;background:var(--gold);border-radius:2px}
    .section-head h2{font-size:clamp(31px,4vw,47px);line-height:1.2;color:var(--navy);margin-bottom:11px}
    .section-head p{color:var(--muted);font-size:14px;margin-bottom:0}

    .about-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:44px;align-items:center}
    .about-visual{min-height:430px;border-radius:32px;position:relative;overflow:hidden;background:linear-gradient(135deg,#155ad4,#825cf2);box-shadow:var(--shadow)}
    .about-visual svg{position:absolute;inset:0;width:100%;height:100%}
    .about-badge{position:absolute;left:24px;bottom:24px;z-index:2;background:rgba(255,255,255,.91);backdrop-filter:blur(10px);padding:14px 17px;border-radius:16px;color:var(--navy);box-shadow:0 12px 30px rgba(0,0,0,.12)}
    .about-badge strong{font-size:20px;display:block}.about-badge span{font-size:10px;color:#64748b;font-weight:800}
    .about-copy h2{font-size:clamp(31px,4vw,49px);line-height:1.2;color:var(--navy);margin-bottom:14px}
    .about-copy>p{color:var(--muted);font-size:14px;line-height:2;margin-bottom:24px}
    .about-list{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .about-item{display:flex;align-items:flex-start;gap:10px;padding:13px;border:1px solid var(--line);background:#fff;border-radius:15px}
    .about-item i{width:31px;height:31px;flex:0 0 31px;display:grid;place-items:center;border-radius:10px;background:#eef5ff;color:var(--blue)}
    .about-item strong{font-size:12px;display:block}.about-item span{font-size:10px;color:#7a889c}

    .services{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
    .service{position:relative;overflow:hidden;border-radius:23px;padding:20px;background:#fff;border:1px solid var(--line);box-shadow:0 12px 32px rgba(13,46,99,.07);transition:.25s}
    .service:hover{transform:translateY(-6px);border-color:#d2e2ff;box-shadow:0 20px 45px rgba(13,46,99,.13)}
    .service-thumb{height:146px;overflow:hidden;border-radius:18px;margin:-2px -2px 16px;background:#eef4ff;border:1px solid #edf2fa}
    .service-thumb img{width:100%;height:100%;object-fit:cover;display:block}
    .service-icon{width:52px;height:52px;border-radius:17px;display:grid;place-items:center;margin-bottom:17px}
    .service:nth-child(1) .service-icon{background:#eaf3ff;color:#2161df}
    .service:nth-child(2) .service-icon{background:#e8fff7;color:#0aa97a}
    .service:nth-child(3) .service-icon{background:#fff5db;color:#c79200}
    .service:nth-child(4) .service-icon{background:#f1eaff;color:#7454dc}
    .service h3{font-size:16px;color:var(--navy);margin-bottom:7px}
    .service p{font-size:11px;color:#74839a;line-height:1.9;min-height:63px}
    .service a{display:inline-flex;align-items:center;gap:6px;color:var(--blue);font-size:11px;font-weight:900}

    .reviews-wrap{position:relative;overflow:hidden;border-radius:34px;background:linear-gradient(135deg,var(--navy),#123b7b);padding:48px 38px;color:#fff;box-shadow:var(--shadow)}
    .reviews-wrap:before{content:"";position:absolute;width:360px;height:360px;border-radius:50%;right:-110px;top:-170px;background:radial-gradient(circle,rgba(63,207,255,.28),transparent 68%)}
    .reviews-head{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:flex-end;gap:25px;margin-bottom:26px}
    .reviews-head h2{font-size:36px;margin:0}.reviews-head p{margin:0;color:#cad8f3;font-size:12px}
    .rating-chip{display:flex;align-items:center;gap:9px;padding:10px 14px;border-radius:14px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15)}
    .rating-chip b{color:var(--gold);letter-spacing:1px}
    .review-grid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    .review{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(9px);border-radius:20px;padding:19px}
    .review-top{display:flex;justify-content:space-between;gap:14px;align-items:center;margin-bottom:11px}
    .review-name{display:flex;align-items:center;gap:9px}
    .review-avatar{width:38px;height:38px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,var(--sky),var(--violet));font-weight:900}
    .review-name strong{display:block;font-size:12px}.review-name small{color:#aebfe0;font-size:9px}
    .review-stars{color:var(--gold);font-size:12px;letter-spacing:1px}
    .review p{margin:0;color:#e4ebf9;font-size:11px;line-height:1.9}

    .contact-panel{display:grid;grid-template-columns:1.1fr .9fr;gap:0;border-radius:32px;overflow:hidden;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow)}
    .contact-copy{padding:42px}
    .contact-copy h2{font-size:39px;color:var(--navy);line-height:1.25;margin-bottom:10px}
    .contact-copy p{color:var(--muted);font-size:13px;max-width:560px}
    .contact-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:21px}
    .contact-visual{background:linear-gradient(135deg,#0d2e63,#2368ff);min-height:330px;position:relative;overflow:hidden;color:#fff;display:grid;place-items:center;padding:28px;text-align:center}
    .contact-visual:before,.contact-visual:after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.18)}
    .contact-visual:before{width:260px;height:260px}.contact-visual:after{width:340px;height:340px}
    .contact-number{position:relative;z-index:1}
    .contact-number i{width:64px;height:64px;border-radius:21px;margin:0 auto 12px;display:grid;place-items:center;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.2)}
    .contact-number small{display:block;color:#cfe0ff;font-size:11px;font-weight:800}.contact-number strong{display:block;font-size:31px;direction:ltr;letter-spacing:1px}

    footer{background:#07162f;color:#c9d5ea;padding:44px 0 24px}
    .footer-grid{display:grid;grid-template-columns:1.3fr .85fr .85fr;gap:35px;padding-bottom:30px;border-bottom:1px solid rgba(255,255,255,.09)}
    .footer-brand{font-size:24px;color:#fff;font-weight:900;display:flex;align-items:center;gap:10px}.footer-logo{width:190px;max-width:100%;opacity:1}.footer-copy{font-size:11px;max-width:400px;line-height:1.9;color:#91a4c2}
    .footer-col h3{font-size:13px;color:#fff;margin-bottom:13px}.footer-col a{display:block;color:#9fb0ca;font-size:11px;margin:8px 0}.footer-col a:hover{color:#fff}
    .footer-bottom{display:flex;justify-content:space-between;gap:20px;align-items:center;padding-top:20px;color:#8193ae;font-size:10px}
    .designer a{color:#fff;font-weight:900;text-decoration:underline;text-decoration-color:var(--mint);text-underline-offset:5px}

    .floating-contact{position:fixed;z-index:70;left:18px;bottom:20px;display:flex;flex-direction:column;gap:10px}
    .float{width:58px;height:58px;border-radius:20px;display:grid;place-items:center;color:#fff;border:3px solid rgba(255,255,255,.9);box-shadow:0 14px 30px rgba(10,29,62,.25);transition:.2s}
    .float:hover{transform:translateY(-4px) scale(1.03)}
    .float-wa{background:linear-gradient(135deg,#16c978,#0daf65)}
    .float-call{background:linear-gradient(135deg,#ff665e,#ee3d50)}

    @media(max-width:1050px){.nav-links{gap:16px}.nav-actions .nav-call{display:none}.services{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:860px){
      .topbar .top-note{display:none}
      .menu-btn{display:grid;place-items:center}
      .nav-links{position:absolute;top:82px;right:17px;left:17px;display:none;flex-direction:column;align-items:stretch;gap:0;background:#fff;border:1px solid var(--line);border-radius:20px;padding:10px 18px;box-shadow:var(--shadow)}
      .nav-links.open{display:flex}.nav-links a{padding:13px 2px;border-bottom:1px solid #f0f3f8}.nav-links a:last-child{border:0}.nav-links a:after{display:none}
      .hero{padding-top:44px}.hero-grid{grid-template-columns:1fr;gap:34px}.hero-slider{min-height:420px}
      .portal-grid{grid-template-columns:1fr 1fr}.portal:last-child{grid-column:1/-1}
      .about-grid{grid-template-columns:1fr}.about-visual{min-height:340px}.review-grid{grid-template-columns:1fr}.reviews-head{flex-direction:column;align-items:flex-start}.contact-panel{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}
    }
    @media(max-width:560px){
      .wrap{width:calc(100% - 24px)}.topbar{font-size:10px}.nav{min-height:72px}.brand-logo-img{width:160px;max-width:58vw}.nav-actions{display:none}.nav-links{top:72px}
      h1{font-size:clamp(40px,13vw,58px)}.hero-copy{font-size:13px}.hero-actions .btn{width:100%}.hero-slider{min-height:360px;border-radius:26px 8px 26px 26px}.slide{padding:22px}.slide h2{font-size:25px}.slider-controls{display:none}.slider-dots{left:16px;top:16px}
      .portals{padding-bottom:55px}.portal-grid{grid-template-columns:1fr}.portal:last-child{grid-column:auto}.portal{min-height:205px}.section{padding:58px 0}.section-head{margin-bottom:27px}.section-head h2{font-size:31px}.about-list{grid-template-columns:1fr}.services{grid-template-columns:1fr}.service p{min-height:0}.reviews-wrap{padding:30px 18px;border-radius:26px}.reviews-head h2{font-size:29px}.contact-copy{padding:30px 20px}.contact-copy h2{font-size:31px}.contact-actions .btn{width:100%}.contact-visual{min-height:270px}.footer-grid{grid-template-columns:1fr}.footer-grid>div:first-child{grid-column:auto}.footer-bottom{flex-direction:column;align-items:flex-start}.floating-contact{left:10px;bottom:12px}.float{width:52px;height:52px;border-radius:17px}
    }
  </style>
</head>
<body id="home">
  <div class="topbar">
    <div class="wrap">
      <span class="top-note">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v4m0 10v4M3 12h4m10 0h4M5.6 5.6l2.8 2.8m7.2 7.2 2.8 2.8m0-12.8-2.8 2.8m-7.2 7.2-2.8 2.8"/></svg>
        تنظيف احترافي في الرياض — نصل إليك أينما كنت
